# ─── Required ───────────────────────────────────────────────────────────
# Comma-separated API keys, each >= 24 chars. Generate: openssl rand -hex 24
API_KEYS=
# 32-byte key (64 hex chars) encrypting session cookies and webhook secrets at rest.
# Generate: openssl rand -hex 32   — losing it means re-scanning the QR code.
MASTER_KEY=
# Set to the old key while rotating MASTER_KEY (decrypt-only).
# MASTER_KEY_PREVIOUS=

# ─── Topology ───────────────────────────────────────────────────────────
# all = one process (default); api / worker = split deployment over Redis.
ROLE=all
# Identifies the Arattai account; namespaces Redis keys and queues.
SESSION_ID=default
# file | redis   and   memory | bullmq   (api/worker roles require redis + bullmq)
STORE_DRIVER=file
QUEUE_DRIVER=memory
DATA_DIR=./data
# REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=arattix
LEASE_TTL_MS=30000

# ─── HTTP ───────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3000
WORKER_PORT=3001
# false | true | <hop count> | <subnet list>. Set when behind a reverse proxy.
TRUST_PROXY=false
HTTP_RATE_LIMIT_PER_MINUTE=300
# Protects /metrics when set (Authorization: Bearer <token>).
# METRICS_TOKEN=
# Admin web UI at /ui (sign in with one of API_KEYS). false to serve the API only.
UI_ENABLED=true

# ─── Logging ────────────────────────────────────────────────────────────
# error | warn | info | http (access logs) | verbose | debug
LOG_LEVEL=info
# json (default in production) | pretty
# LOG_FORMAT=json
# Log records and events kept for the admin UI's Logs and Events pages
# (in Redis when STORE_DRIVER=redis, so the API process shows the worker's too).
LOG_BUFFER_SIZE=2000
EVENT_BUFFER_SIZE=500

# ─── Connection lifecycle ───────────────────────────────────────────────
HEARTBEAT_INTERVAL_MS=60000
HEARTBEAT_TIMEOUT_MS=15000
HEARTBEAT_FAILURE_THRESHOLD=3
RECONNECT_BASE_MS=2000
RECONNECT_MAX_MS=300000
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_MS=30000
QR_TIMEOUT_MS=180000
QR_POLL_INTERVAL_MS=5000

# ─── Outbound pacing (anti-flagging) ────────────────────────────────────
SEND_RATE_PER_MINUTE=20
SEND_BURST=5
SEND_PER_CHAT_INTERVAL_MS=1500
SEND_JITTER_MS=750
# Drop queued sends older than this instead of delivering them late.
MESSAGE_TTL_MS=600000
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=2000
QUEUE_MAX_PENDING=5000
# How long a synchronous request waits before answering 202 + job id.
SYNC_WAIT_TIMEOUT_MS=25000

# ─── Media ──────────────────────────────────────────────────────────────
MEDIA_MAX_BYTES=67108864
SPOOL_MAX_AGE_MS=86400000

# ─── Broadcasts ─────────────────────────────────────────────────────────
BROADCAST_MAX_RECIPIENTS=1000
BROADCAST_MIN_CHUNK_DELAY_MS=5000

# ─── Inbound polling (the library has no push channel) ─────────────────
POLL_ENABLED=true
POLL_INTERVAL_MS=5000
POLL_MAX_INTERVAL_MS=60000
POLL_CHAT_LIMIT=30
POLL_CHATS_PER_TICK=5
POLL_CHATLIST_EVERY=3
POLL_MESSAGE_LIMIT=20
# Your own Arattai user id; enables filtering of your own messages.
# SELF_USER_ID=
POLL_EMIT_SELF=false

# ─── Webhooks ───────────────────────────────────────────────────────────
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_BACKOFF_MS=5000
# Development only: allow http:// and private/loopback receivers.
WEBHOOK_ALLOW_HTTP=false
WEBHOOK_ALLOW_PRIVATE=false
WEBHOOK_MAX_CONSECUTIVE_FAILURES=50

# ─── Arattai ────────────────────────────────────────────────────────────
# Re-point a moved endpoint without a release, e.g.
# ARATTAI_ENDPOINT_OVERRIDES={"SEND_MESSAGE_URL":"https://web.arattai.in/v2/messages"}
# ARATTAI_USER_AGENT=

SHUTDOWN_TIMEOUT_MS=25000
