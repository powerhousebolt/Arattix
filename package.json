{
  "name": "arattix",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js library for Arattai messaging API \u2014 send messages, media, and build bots.",
  "main": "index.js",
  "scripts": {
    "example": "node Example/simple-bot.js",
    "test": "npm run test:lib && npm --prefix server test",
    "test:lib": "node --test test/*.test.js",
    "docker:build": "docker build -t arattix-bot .",
    "docker:run": "docker run -it --rm -v arattix-bot-data:/data arattix-bot",
    "docker:prod": "docker compose up -d bot",
    "docker:dev": "docker compose --profile dev up bot-dev",
    "docker:logs": "docker compose logs -f bot",
    "docker:server": "docker compose --profile server up -d --build server",
    "docker:server:split": "docker compose -f server/docker-compose.yml up -d --build"
  },
  "keywords": [
    "arattai",
    "arattix",
    "messaging",
    "automation",
    "bot",
    "chat",
    "media",
    "api"
  ],
  "author": "SafwanGanz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/powerhousebolt/Arattix"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "axios-cookiejar-support": "^4.0.7",
    "mime-types": "^2.1.35",
    "qrcode-terminal": "^0.12.0",
    "tough-cookie": "^4.1.3"
  }
}
